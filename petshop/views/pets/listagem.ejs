<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Pets Disponíveis - Pet Shop</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav>
  <span class="logo">🐾 Pet Shop</span>
  <a href="/projects">Projetos</a>
  <a href="/pets">Ver Pets</a>
  <% if (usuario) { %>
    <a href="/pets/gerencia">Gerência</a>
    <a href="/usuarios/logout">Sair (<%=usuario.nome%>)</a>
  <% } else { %>
    <a href="/usuarios/login">Login</a>
    <a href="/usuarios/cadastro">Cadastro</a>
  <% } %>
</nav>

<div class="container">
  <h1>🐾 Pets Disponíveis</h1>

  <% if (pets.length === 0) { %>
    <p>Nenhum pet cadastrado ainda.</p>
  <% } else { %>
    <div class="cards">
      <% pets.forEach(function(pet) { %>
        <div class="card">
          <div class="icone">🐾</div>
          <h3><%= pet.especie %></h3>
          <p><strong>Raça:</strong> <%= pet.raca %></p>
          <p><strong>Idade:</strong> <%= pet.idade %> ano(s)</p>
          <p class="preco">R$ <%= pet.preco.toFixed(2) %></p>

          <% if (pet.qtde_disponivel === 0) { %>
            <span class="esgotado">ESGOTADO</span>
          <% } else { %>
            <span class="disponivel"><%= pet.qtde_disponivel %> disponível(is)</span>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

</body>
</html>

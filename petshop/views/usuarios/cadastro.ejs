<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Cadastro - Pet Shop</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav>
  <span class="logo">🐾 Pet Shop</span>
  <a href="/projects">Projetos</a>
  <a href="/pets">Ver Pets</a>
  <% if (usuario) { %>
    <a href="/pets/gerencia">Gerência</a>
    <a href="/usuarios/logout">Sair (<%=usuario.nome%>)</a>
  <% } else { %>
    <a href="/usuarios/login">Login</a>
    <a href="/usuarios/cadastro">Cadastro</a>
  <% } %>
</nav>

<div class="container">
  <h1>Cadastro de Usuário</h1>

  <div class="form-box">

    <% if (erro) { %>
      <div class="alerta-erro"><%= erro %></div>
    <% } %>

    <% if (sucesso) { %>
      <div class="alerta-sucesso"><%= sucesso %></div>
    <% } %>

    <form method="POST" action="/usuarios/cadastro">

      <label>Nome completo</label>
      <input type="text" name="nome" placeholder="Seu nome" required>

      <label>Login</label>
      <input type="text" name="login" placeholder="Escolha um login" required>

      <label>Senha</label>
      <input type="password" name="senha" placeholder="Escolha uma senha" required>

      <button type="submit" class="btn btn-verde" style="width:100%">Cadastrar</button>

    </form>

    <p style="margin-top:16px; text-align:center; font-size:14px;">
      Já tem conta? <a href="/usuarios/login">Fazer login</a>
    </p>

  </div>
</div>

</body>
</html>

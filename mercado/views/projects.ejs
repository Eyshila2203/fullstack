<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Projetos - Mercado</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav>
  <span class="logo">🛒 Mercado</span>
  <a href="/projects">Projetos</a>
  <a href="/produtos">Ver Produtos</a>
  <% if (usuario) { %>
    <a href="/produtos/gerencia">Gerência</a>
    <a href="/usuarios/logout">Sair (<%= usuario.nome %>)</a>
  <% } else { %>
    <a href="/usuarios/login">Login</a>
    <a href="/usuarios/cadastro">Cadastro</a>
  <% } %>
</nav>

<div class="container">
  <h1>Projetos</h1>

  <div class="tabela-projetos">
    <table>
      <thead>
        <tr>
          <th>Projeto</th>
          <th>Link</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Cadastro de Usuário</td>
          <td><a href="/usuarios/cadastro">Acessar</a></td>
        </tr>
        <tr>
          <td>Login de Usuário</td>
          <td><a href="/usuarios/login">Acessar</a></td>
        </tr>
        <tr>
          <td>Listagem de Produtos</td>
          <td><a href="/produtos">Acessar</a></td>
        </tr>
        <tr>
          <td>Gerência de Produtos</td>
          <td><a href="/produtos/gerencia">Acessar</a></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

</body>
</html>

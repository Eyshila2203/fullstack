<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Editar Produto - Mercado</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav>
  <span class="logo">🛒 Mercado</span>
  <a href="/projects">Projetos</a>
  <a href="/produtos">Ver Produtos</a>
  <a href="/produtos/gerencia">Gerência</a>
  <a href="/usuarios/logout">Sair (<%= usuario.nome %>)</a>
</nav>

<div class="container">
  <h1>Editar Produto</h1>

  <div class="form-box" style="max-width:500px">
    <form method="POST" action="/produtos/atualizar/<%= produto._id %>">

      <label>Nome</label>
      <input type="text" name="nome" value="<%= produto.nome %>" required>

      <label>Categoria</label>
      <select name="categoria" required>
        <option value="Alimentos"    <%= produto.categoria === 'Alimentos'  ? 'selected' : '' %>>Alimentos</option>
        <option value="Bebidas"      <%= produto.categoria === 'Bebidas'    ? 'selected' : '' %>>Bebidas</option>
        <option value="Limpeza"      <%= produto.categoria === 'Limpeza'    ? 'selected' : '' %>>Limpeza</option>
        <option value="Higiene"      <%= produto.categoria === 'Higiene'    ? 'selected' : '' %>>Higiene</option>
        <option value="Hortifruti"   <%= produto.categoria === 'Hortifruti' ? 'selected' : '' %>>Hortifruti</option>
        <option value="Frios"        <%= produto.categoria === 'Frios'      ? 'selected' : '' %>>Frios</option>
        <option value="Padaria"      <%= produto.categoria === 'Padaria'    ? 'selected' : '' %>>Padaria</option>
        <option value="Outros"       <%= produto.categoria === 'Outros'     ? 'selected' : '' %>>Outros</option>
      </select>

      <label>Marca</label>
      <input type="text" name="marca" value="<%= produto.marca %>" required>

      <label>Preço (R$)</label>
      <input type="number" name="preco" value="<%= produto.preco %>" min="0" step="0.01" required>

      <label>Qtde em estoque</label>
      <input type="number" name="qtde_disponivel" value="<%= produto.qtde_disponivel %>" min="0" required>

      <div style="display:flex; gap:10px; margin-top:6px">
        <button type="submit" class="btn btn-laranja">Salvar</button>
        <a href="/produtos/gerencia" class="btn btn-amarelo">Cancelar</a>
      </div>

    </form>
  </div>
</div>

</body>
</html>

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Editar Carro</title>
    <link rel="stylesheet" href="/public/estilo.css">
</head>
<body>
    <header>
        <h1>PORTFÓLIO</h1>
        <nav>
            <a href="/">Projetos</a>
            <a href="/carros">Carros</a>
        </nav>
    </header>

    <div class="container">
        <div class="card" style="margin-top: 3rem;">
            <h2>EDITAR CARRO</h2>
            <form action="/carro/atualizar/<%= carro._id %>" method="POST">
                <div class="form-group">
                    <label>Marca</label>
                    <input type="text" name="marca" value="<%= carro.marca %>" required>
                </div>
                <div class="form-group">
                    <label>Modelo</label>
                    <input type="text" name="modelo" value="<%= carro.modelo %>" required>
                </div>
                <div class="form-group">
                    <label>Ano</label>
                    <input type="number" name="ano" value="<%= carro.ano %>" required>
                </div>
                <div class="form-group">
                    <label>Quantidade Disponível</label>
                    <input type="number" name="qtde" value="<%= carro.qtde_disponivel %>" min="0" required>
                </div>
                <button type="submit" class="btn btn-primary btn-full" style="margin-top: 1rem;">Salvar Alterações</button>
            </form>
            <p class="text-center mt-1"><a href="/carros" class="link">← Voltar</a></p>
        </div>
    </div>
</body>
</html>
